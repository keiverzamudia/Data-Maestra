# =============================================================================
# DOCKER ENVIRONMENT
# =============================================================================
# This file is used when running with Docker Compose.
# The database name differs from local to avoid conflicts.

# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database - Docker PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/master_data?schema=public

# CORS
CORS_ORIGINS=http://localhost:5173

# Logging
LOG_LEVEL=debug
