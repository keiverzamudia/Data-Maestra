# Data-Maestra — Desarrollo local (Profit READ-ONLY)
# Creado 2026-09-03 para AD_DIST. Ver docs/CAMBIO_CONEXION_PROFIT.md
# Este archivo NO se commitea (gitignore). Copiado de apps/api/.env + PROFIT vars.

# --- Data-Maestra (Prisma/SQLite dev) ---
DATABASE_URL="file:../data/dev.db"
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=debug

# --- Profit SQL Server (READ-ONLY) ---
PROFIT_DB_SERVER=SRVBDPROFITBK
PROFIT_DB_DATABASE=AD_TRANS
PROFIT_DB_USER=solicitudweb
PROFIT_DB_PASSWORD=solicitudweb
PROFIT_ENV=production
PROFIT_WRITE_ENABLED=true

# --- Profit escritura (14J): Auth windows = driver
# nativo msnodesqlv8 + ODBC con la identidad del proceso API (tedious v20
# ignora trustedConnection: probado ELOGIN, no reintentarlo).
# Auth sql = PROFIT_WRITE_USER/PASSWORD explícitos (cuenta técnica DBA).
# Flag permanece OFF.
PROFIT_WRITE_AUTH=windows
PROFIT_WRITE_SERVER=SRVBDPROFITBK
PROFIT_WRITE_DATABASE=AD_TRANS

# --- Trazabilidad de origen (14Q/14Q.1): código funcional escrito en co_us_in.
# Backend-only. NO es credencial. NO crear usuario DM en Profit por SQL.
PROFIT_INTEGRATION_USER_CODE=DM
