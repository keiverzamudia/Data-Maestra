# Database (SQLite dev) — ruta relativa a prisma/schema.prisma
DATABASE_URL="file:../data/dev.db"

# Application
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# CORS
CORS_ORIGINS=http://localhost:5173

# Logging
LOG_LEVEL=debug

# Modo pruebas: habilita el borrado de datos operativos (Maintenance).
# Default deshabilitado; nunca en producción.
ALLOW_TEST_RESET=false

# Profit SQL Server (READ-ONLY) — completar credenciales reales en .env.local
PROFIT_DB_SERVER=
PROFIT_DB_DATABASE=
PROFIT_DB_USER=
PROFIT_DB_PASSWORD=
PROFIT_ENV=production
PROFIT_WRITE_ENABLED=false

# Profit escritura (auth windows = identidad del proceso API)
PROFIT_WRITE_AUTH=windows
PROFIT_WRITE_SERVER=
PROFIT_WRITE_DATABASE=

# Trazabilidad de origen (código funcional en co_us_in). No es credencial.
PROFIT_INTEGRATION_USER_CODE=DM
