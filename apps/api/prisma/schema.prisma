// Prisma schema for SQLite (development only)
// Production will use SQL Server

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =============================================================================
// MDM SCHEMA — SQLite Development Version
// =============================================================================
// Differences from PostgreSQL production:
// - No enums (use String instead)
// - No @db.Uuid, @db.VarChar, @db.Text, @db.Inet, @db.Decimal
// - No GIN indexes
// - No partial unique indexes
// - JSON stored as String (SQLite doesn't have native JSON type)
// - request_number uses UUID-based generation instead of autoincrement
// =============================================================================

// --- Companies ---

model Company {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  departments  Department[]
  requests     Request[]
  userRoles    UserRole[]
  auditEvents  AuditEvent[]  @relation("ActorCompany")
  importRuns   ImportRun[]
  sourceItems  SourceItem[]

  @@map("companies")
}

// --- Users & Auth ---

model User {
  id          String   @id @default(uuid())
  username    String   @unique
  displayName String   @map("display_name")
  email       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  // --- FASE 10B: autenticación real (sin lógica todavía) ---
  // Código externo estable proveniente de Profit (referencia para sincronización).
  // Nullable para compatibilidad con usuarios creados antes de 10B.
  profitCode String? @unique @map("profit_code")
  // FASE 15: sin contraseña local — se valida contra MasterProfit.dbo.autenticar().
  lastLoginAt        DateTime? @map("last_login_at")

  userRoles       UserRole[]
  permissionOverrides UserPermissionOverride[]
  sessions        Session[]
  auditEvents     AuditEvent[]
  workflowTasks   WorkflowTask[]  @relation("AssignedTo")
  workflowHistory WorkflowHistory[]
  requests        Request[]
  createdMasterItems MasterItem[]
  approvals       Approval[]
  notifications   Notification[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  // FASE 18 §9-§10: vista principal del rol (clave de ROLE_VIEWS; null = fallback).
  defaultView String?

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  description String?

  rolePermissions RolePermission[]
  userOverrides UserPermissionOverride[]

  @@map("permissions")
}

model UserRole {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  roleId    String    @map("role_id")
  companyId String    @map("company_id")
  // --- 10E-A: pertenencia Usuario + Rol + Empresa + Departamento.
  // Nullable: solo se asigna con evidencia inequívoca (ver backfill 10E-A).
  // Regla de integridad (nivel aplicación): el departamento debe pertenecer
  // a la misma empresa (UserRole.companyId === Department.companyId).
  departmentId String? @map("department_id")
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  @@unique([userId, roleId, companyId, departmentId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// --- FASE 10B: RBAC por usuario, sesiones y sincronización Profit ---
// Sin lógica todavía (fases 10C-10E). Este bloque solo prepara el modelo.
//
// Convención del proyecto (SQLite dev): sin enums de Prisma, se usa String.
// effect admite 'GRANT' | 'DENY' (validado a nivel aplicación en 10G).

model UserPermissionOverride {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  permissionId String   @map("permission_id")
  effect       String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @map("updated_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@map("user_permission_overrides")
}

model Session {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  // Hash del token (nunca el token en claro). Preparado para JWT + sesión
  // persistente (10E); no se asume todavía qué token se hashea.
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  ip        String?
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model ProfitUserSyncRun {
  id         String    @id @default(uuid())
  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")
  created    Int       @default(0)
  updated    Int       @default(0)
  missing    Int       @default(0)
  errors     Int       @default(0)
  // Detalle JSON como String (convención SQLite del proyecto).
  details    String    @default("{}")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("profit_user_sync_runs")
}

// --- Departments ---

model Department {
  id          String    @id @default(uuid())
  companyId   String    @map("company_id")
  name        String
  code        String
  managerId   String?   @map("manager_id")
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @map("updated_at")

  company  Company   @relation(fields: [companyId], references: [id])
  requests Request[]
  userRoles UserRole[]

  @@unique([companyId, code])
  @@map("departments")
}

// --- Catalog ---

model CatalogGroup {
  id           String  @id @default(uuid())
  code         String  @unique
  name         String
  active       Boolean @default(true)
  sourceSystem String? @map("source_system")
  sourceCode   String? @map("source_code")
  // Tipo Profit sugerido para artículos nuevos de esta línea (FASE 14C-FORM §6:
  // sugerencia, no obligación; el tipo pertenece a la solicitud).
  defaultArticleType String? @map("default_article_type")

  subgroups   CatalogSubgroup[]
  masterItems MasterItem[]

  @@map("catalog_groups")
}

model CatalogSubgroup {
  id           String  @id @default(uuid())
  groupId      String  @map("group_id")
  code         String
  name         String
  active       Boolean @default(true)
  sourceSystem String? @map("source_system")
  sourceCode   String? @map("source_code")

  group       CatalogGroup     @relation(fields: [groupId], references: [id])
  categories  CatalogCategory[]
  masterItems MasterItem[]

  @@unique([groupId, code])
  @@map("catalog_subgroups")
}

model CatalogCategory {
  id         String  @id @default(uuid())
  subgroupId String  @map("subgroup_id")
  code       String
  name       String
  active     Boolean @default(true)

  subgroup    CatalogSubgroup @relation(fields: [subgroupId], references: [id])
  masterItems MasterItem[]

  @@unique([subgroupId, code])
  @@map("catalog_categories")
}

model Brand {
  id             String   @id @default(uuid())
  name           String
  normalizedName String   @map("normalized_name") @unique
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")

  masterItems MasterItem[]

  @@map("brands")
}

model UnitOfMeasure {
  id     String  @id @default(uuid())
  code   String  @unique
  name   String
  active Boolean @default(true)

  masterItems MasterItem[]

  @@map("units_of_measure")
}

// --- Catálogos Profit: visibilidad local (FASE CAT) ---
//
// Profit es la fuente oficial (solo lectura). Estas tablas NUNCA modifican
// Profit: controlan qué valores son visibles/seleccionables en Data-Maestra
// (catálogo efectivo = Profit + configuración). companyId NULL = global;
// si existe fila por empresa, prevalece sobre la global.

model CatalogVisibilityMode {
  id          String   @id @default(uuid())
  catalogType String   @map("catalog_type")
  companyId   String   @default("") @map("company_id")
  mode        String   @default("ALL")
  actorId     String?  @map("actor_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")

  @@unique([catalogType, companyId])
  @@map("catalog_visibility_modes")
}

model CatalogVisibilityItem {
  id                String    @id @default(uuid())
  catalogType       String    @map("catalog_type")
  profitCode        String    @map("profit_code")
  parentCode        String    @default("") @map("parent_code")
  companyId         String    @default("") @map("company_id")
  description       String?
  availableInProfit Boolean   @default(true) @map("available_in_profit")
  visible           Boolean   @default(false)
  decided           Boolean   @default(false)
  synchronizedAt    DateTime? @map("synchronized_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @map("updated_at")

  @@unique([catalogType, profitCode, parentCode, companyId])
  @@map("catalog_visibility_items")
}

// --- Master Items ---

model MasterItem {
  id                    String   @id @default(uuid())
  masterCode            String   @map("master_code") @unique
  masterDescription     String   @map("master_description")
  normalizedDescription String   @map("normalized_description")
  status                String   @default("PENDING_REVIEW")
  groupId               String?  @map("group_id")
  subgroupId            String?  @map("subgroup_id")
  categoryId            String?  @map("category_id")
  brandId               String?  @map("brand_id")
  unitId                String?  @map("unit_id")
  manufacturer          String?
  model                 String?
  partNumber            String?  @map("part_number")
  application           String?
  attributes            String   @default("{}")
  createdBy             String?  @map("created_by")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @default(now()) @map("updated_at")

  group      CatalogGroup?     @relation(fields: [groupId], references: [id])
  subgroup   CatalogSubgroup?  @relation(fields: [subgroupId], references: [id])
  category   CatalogCategory?  @relation(fields: [categoryId], references: [id])
  brand      Brand?            @relation(fields: [brandId], references: [id])
  unit       UnitOfMeasure?    @relation(fields: [unitId], references: [id])
  createdByUser User?          @relation(fields: [createdBy], references: [id])

  @@index([status])
  @@map("master_items")
}

// --- FASE 18 (motor de coincidencia): identidad y normalización ---
// ArticleNormalizationProfile: representación auxiliar por artículo Profit
// (companyCode + profitArticleCode, nunca solo el código). La descripción
// original se preserva siempre; la normalizada es derivada versionada.
// ArticleMatchDecision: decisión humana SAME/DIFFERENT/REVIEW entre dos
// artículos. Solo registra; no crea maestros ni toca Profit. La pareja se
// ordena canónicamente y pairKey evita duplicados A-B/B-A.

model ArticleNormalizationProfile {
  id                    String   @id @default(uuid())
  companyCode           String   @map("company_code")
  profitArticleCode     String   @map("profit_article_code")
  originalDescription   String   @map("original_description")
  normalizedDescription String   @map("normalized_description")
  normalizationVersion  String   @default("v1") @map("normalization_version")
  // FASE 19: representación comparable v2 (tokens y señales como texto
  // JSON; escalares simples, sin Json insurer: SQLite + Prisma 6).
  tokensJson            String?  @map("tokens_json")
  featuresJson          String?  @map("features_json")
  // FASE 22: origen del perfil (NULL = previo/flujo solicitud, 'HISTORICO'
  // = carga del universo), cobertura de información y fingerprint de
  // preselección (agrupación futura, jamás identidad).
  origin                String?
  coverage              String?
  fingerprint           String?
  brand                 String?
  model                 String?
  partNumber            String?  @map("part_number")
  category              String?
  subCategory           String?  @map("sub_category")
  unit                  String?
  application           String?
  photoReference        String?  @map("photo_reference")
  normalizedAt          DateTime @default(now()) @map("normalized_at")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @default(now()) @map("updated_at")

  @@unique([companyCode, profitArticleCode])
  @@index([normalizedDescription])
  @@index([fingerprint])
  @@map("article_normalization_profiles")
}

model ArticleMatchDecision {
  id                String    @id @default(uuid())
  articleACompany   String    @map("article_a_company")
  articleAProfitCode String   @map("article_a_profit_code")
  articleBCompany   String    @map("article_b_company")
  articleBProfitCode String   @map("article_b_profit_code")
  pairKey           String    @unique @map("pair_key")
  decision          String
  reason            String?
  evidenceJson      String?   @map("evidence_json")
  decidedBy         String?   @map("decided_by")
  decidedAt         DateTime  @default(now()) @map("decided_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @map("updated_at")

  @@index([decision])
  @@map("article_match_decisions")
}

// FASE 23 — Detección histórica de posibles duplicados. Relaciones NO
// dirigidas entre perfiles (pairKey canónico), evidencia/conflictos del
// motor v1 y grupos conservadores (cliques, PENDIENTE_REVISION).
// DETECCIÓN ≠ DECISIÓN: jamás SAME/DIFFERENT automático.

model HistoricalMatchRelation {
  id                String   @id @default(uuid())
  pairKey           String   @unique @map("pair_key")
  companyACode      String   @map("company_a_code")
  profitACode       String   @map("profit_a_code")
  companyBCode      String   @map("company_b_code")
  profitBCode       String   @map("profit_b_code")
  score             Int
  classification    String
  evidencesJson     String   @map("evidences_json")
  conflictsJson     String   @map("conflicts_json")
  evidenceCount     Int      @default(0) @map("evidence_count")
  conflictCount     Int      @default(0) @map("conflict_count")
  explanation       String
  engineVersion     String   @default("deterministic-v1") @map("engine_version")
  coverageA         String?  @map("coverage_a")
  coverageB         String?  @map("coverage_b")
  status            String   @default("PENDIENTE_REVISION")
  detectedAt        DateTime @default(now()) @map("detected_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @map("updated_at")

  @@index([classification])
  @@index([status])
  @@map("historical_match_relations")
}

model HistoricalMatchGroup {
  id             String   @id @default(uuid())
  status         String   @default("PENDIENTE_REVISION")
  memberCount    Int      @default(0) @map("member_count")
  engineVersion  String   @default("deterministic-v1") @map("engine_version")
  summaryJson    String?  @map("summary_json")
  detectedAt     DateTime @default(now()) @map("detected_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @map("updated_at")

  members HistoricalMatchGroupMember[]

  @@map("historical_match_groups")
}

model HistoricalMatchGroupMember {
  id                String   @id @default(uuid())
  groupId           String   @map("group_id")
  companyCode       String   @map("company_code")
  profitArticleCode String   @map("profit_article_code")

  group HistoricalMatchGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, companyCode, profitArticleCode])
  @@map("historical_match_group_members")
}

// FASE 21 — Vínculo solicitud → artículo Profit existente (Comprador
// Inteligente). Estado VIGENTE por solicitud (última decisión manda): SAME
// referencia el artículo a reutilizar y evita crear duplicados;
// DIFFERENT registra el candidato descartado y deja continuar el flujo.
// FASE 23.2 — el historial completo vive en RequestArticleDecision; este
// modelo conserva solo la última decisión para lectura eficiente del estado
// activo. Solo lectura Profit + escritura local. Sin homologación.

model RequestArticleLink {
  id                String   @id @default(uuid())
  requestId         String   @unique @map("request_id")
  companyCode       String   @map("company_code")
  profitArticleCode String   @map("profit_article_code")
  decision          String
  decidedBy         String?  @map("decided_by")
  decidedAt         DateTime @default(now()) @map("decided_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @map("updated_at")

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([decision])
  @@map("request_article_links")
}

// FASE 23.2 — Historial de decisiones del Analizador por solicitud.
// Cada par (solicitud, artículo) guarda su decisión sin sobrescribir:
// A→DIFFERENT, B→DIFFERENT, C→SAME coexisten. El estado vigente se lee en
// RequestArticleLink (última decisión). Sin homologación, sin Profit.

model RequestArticleDecision {
  id                String   @id @default(uuid())
  requestId         String   @map("request_id")
  companyCode       String   @map("company_code")
  profitArticleCode String   @map("profit_article_code")
  decision          String
  decidedBy         String?  @map("decided_by")
  decidedAt         DateTime @default(now()) @map("decided_at")
  createdAt         DateTime @default(now()) @map("created_at")

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, companyCode, profitArticleCode])
  @@index([requestId])
  @@map("request_article_decisions")
}

// --- Requests ---

model Request {
  id                    String   @id @default(uuid())
  requestNumber         String   @unique @map("request_number")
  companyId             String   @map("company_id")
  departmentId          String   @map("department_id")
  requesterId           String   @map("requester_id")
  requestedDescription  String   @map("requested_description")
  purpose               String
  referencePhotoUri     String?  @map("reference_photo_uri")
  status                String   @default("BORRADOR")
  priority              Int      @default(0)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @default(now()) @map("updated_at")

  company    Company    @relation(fields: [companyId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])
  requester  User       @relation(fields: [requesterId], references: [id])

  requestData          RequestData?
  workflowInstance     WorkflowInstance?
  approvals            Approval[]
  accountingCodes      RequestAccountingCode[]
  articleLink          RequestArticleLink?
  decisions            RequestArticleDecision[]

  @@index([status])
  @@index([companyId])
  @@index([requesterId])
  @@index([createdAt])
  @@map("requests")
}

model RequestData {
  id               String  @id @default(uuid())
  requestId        String  @map("request_id") @unique
  groupId          String? @map("group_id")
  subgroupId       String? @map("subgroup_id")
  categoryId       String? @map("category_id")
  brandId          String? @map("brand_id")
  unitId           String? @map("unit_id")
  manufacturer     String?
  model            String?
  partNumber       String? @map("part_number")
  application      String?
  masterCode       String? @map("master_code")
  // Clasificación Profit del artículo (FASE 14C-FORM): tipo char(1) del dominio
  // CK_art_TIPO, impuesto tipo_imp (tabulado 1-9), unidad Profit co_uni.
  // articleTypeManual=true indica override de Warehouse sobre el default de línea.
  articleType       String?  @map("article_type")
  articleTypeManual Boolean  @default(false) @map("article_type_manual")
  taxType           String?  @map("tax_type")
  unitCode          String?  @map("unit_code")
  // Código Profit real tras registro exitoso (14L: visible en bandejas).
  profitCode          String?  @map("profit_code")
  // Código Profit de marca/color tal como lo eligió Warehouse (14E: el espejo
  // Brand solo guarda nombre; el código se necesita para co_color).
  brandCode         String?  @map("brand_code")

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("request_data")
}

model RequestAccountingCode {
  id          String  @id @default(uuid())
  requestId   String  @map("request_id")
  code        String
  description String
  // Posición contable c1..c10 (Fase 8E). Nullable para compatibilidad
  // con filas creadas antes de 8E, que no tenían posición.
  position    String? @map("position")

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("request_accounting_codes")
}

// --- Workflow ---

model WorkflowInstance {
  id              String    @id @default(uuid())
  requestId       String    @map("request_id") @unique
  currentStepCode String    @map("current_step_code")
  version         Int       @default(1)
  startedAt       DateTime  @default(now()) @map("started_at")
  updatedAt       DateTime  @default(now()) @map("updated_at")
  completedAt     DateTime? @map("completed_at")

  request  Request          @relation(fields: [requestId], references: [id])
  tasks    WorkflowTask[]
  history  WorkflowHistory[]

  @@map("workflow_instances")
}

model WorkflowTask {
  id          String    @id @default(uuid())
  instanceId  String    @map("instance_id")
  stepCode    String    @map("step_code")
  assignedTo  String?   @map("assigned_to")
  status      String    @default("PENDING")
  dueAt       DateTime? @map("due_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  instance       WorkflowInstance @relation(fields: [instanceId], references: [id])
  assignedToUser User?            @relation("AssignedTo", fields: [assignedTo], references: [id])

  @@unique([instanceId, stepCode])
  @@map("workflow_tasks")
}

model WorkflowHistory {
  id          String   @id @default(uuid())
  instanceId  String   @map("instance_id")
  fromStep    String?  @map("from_step")
  toStep      String?  @map("to_step")
  action      String
  actorId     String   @map("actor_id")
  comment     String?
  createdAt   DateTime @default(now()) @map("created_at")

  instance WorkflowInstance @relation(fields: [instanceId], references: [id])
  actor    User             @relation(fields: [actorId], references: [id])

  @@map("workflow_history")
}

model Approval {
  id          String   @id @default(uuid())
  requestId   String   @map("request_id")
  stepCode    String   @map("step_code")
  actorId     String   @map("actor_id")
  action      String
  fromStatus  String   @map("from_status")
  toStatus    String   @map("to_status")
  comment     String?
  createdAt   DateTime @default(now()) @map("created_at")

  request Request @relation(fields: [requestId], references: [id])
  actor   User    @relation(fields: [actorId], references: [id])

  @@map("approvals")
}

// --- Audit ---

model AuditEvent {
  id              String   @id @default(uuid())
  correlationId   String   @map("correlation_id")
  requestId       String?  @map("request_id")
  actorId         String?  @map("actor_id")
  actorCompanyId  String?  @map("actor_company_id")
  entityType      String   @map("entity_type")
  entityId        String   @map("entity_id")
  action          String
  beforeData      String?  @map("before_data")
  afterData       String?  @map("after_data")
  metadata        String   @default("{}")
  createdAt       DateTime @default(now()) @map("created_at")

  actor         User?    @relation(fields: [actorId], references: [id])
  actorCompany  Company? @relation("ActorCompany", fields: [actorCompanyId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_events")
}

// --- Import Runs ---

model ImportRun {
  id              String    @id @default(uuid())
  sourceName      String    @map("source_name")
  companyId       String?   @map("company_id")
  status          String    @default("COMPLETED")
  startedAt       DateTime  @default(now()) @map("started_at")
  finishedAt      DateTime? @map("finished_at")
  rowsRead        Int       @default(0) @map("rows_read")
  rowsImported    Int       @default(0) @map("rows_imported")
  rowsUnchanged   Int       @default(0) @map("rows_unchanged")
  rowsFailed      Int       @default(0) @map("rows_failed")
  rowsSkipped     Int       @default(0) @map("rows_skipped")
  errorSummary    String?   @map("error_summary")
  createdAt       DateTime  @default(now()) @map("created_at")

  company    Company? @relation(fields: [companyId], references: [id])
  sourceItems SourceItem[]

  @@index([companyId])
  @@index([startedAt])
  @@map("import_runs")
}

// --- Source Items ---

model SourceItem {
  id                    String   @id @default(uuid())
  importRunId           String?  @map("import_run_id")
  companyId             String?  @map("company_id")
  sourceRecordId        String   @map("source_record_id")
  sourceCode            String?  @map("source_code")
  originalDescription   String   @map("original_description")
  normalizedDescription String?  @map("normalized_description")
  brand                 String?
  manufacturer          String?
  model                 String?
  partNumber            String?  @map("part_number")
  status                String   @default("IMPORTED")
  lastSeenAt            DateTime @default(now()) @map("last_seen_at")
  createdAt             DateTime @default(now()) @map("created_at")

  importRun ImportRun? @relation(fields: [importRunId], references: [id])
  company   Company?   @relation(fields: [companyId], references: [id])

  @@index([importRunId])
  @@index([companyId])
  @@index([sourceRecordId])
  @@map("source_items")
}

// --- Notifications ---

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  requestId String?  @map("request_id")
  title     String
  body      String
  type      String   @default("info")
  readAt    DateTime? @map("read_at")
  link      String?
  // 12F — idempotencia por (request, tipo, destinatario); NULL en históricas.
  dedupKey  String?  @unique @map("dedup_key")
  metadata  String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, readAt])
  @@index([requestId])
  @@index([createdAt])
  @@map("notifications")
}
