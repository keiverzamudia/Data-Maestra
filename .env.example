# =============================================================================
# ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env.local for local development (without Docker).
# Copy this file to .env.docker for Docker development.
#
# DO NOT commit .env.local or .env.*.local to Git.

# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database
# Local:  postgresql://user:password@localhost:5432/master_data_dev?schema=public
# Docker: postgresql://postgres:postgres@localhost:5432/master_data?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/master_data_dev?schema=public

# CORS
CORS_ORIGINS=http://localhost:5173

# Logging
LOG_LEVEL=debug

# Profit Integration (FUTURE - DO NOT USE YET)
# PROFIT_DB_HOST=
# PROFIT_DB_PORT=1433
# PROFIT_DB_DATABASE=
# PROFIT_DB_USER=
# PROFIT_DB_PASSWORD_REF=
