# Dependencies
node_modules
.pnpm-store

# Build outputs
dist
build
*.tsbuildinfo

# Vite generated config (from tsc -b)
# Se emiten fuera del source (node_modules/.tmp) y por si acaso se ignoran.
apps/web/vite.config.js
apps/web/vite.config.d.ts

# Environment local/secreto — NUNCA versionar.
# Solo se versionan los *.example y los .env de la app sin secretos.
# El unico archivo que se copia a mano por worktree/clon es .env.local.
/.env
/.env.local
**/.env.local
/.env.*.local
!.env.docker

