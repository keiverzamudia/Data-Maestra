# Perfil local por worktree — NO se versiona.
# Copiar a `.env.local` en la raíz de cada worktree y ajustar.
#
# Ejemplo: worktree A deja 3001/5173; worktree B usa 3002/5174.

# API (NestJS)
API_PORT=3001

# Web (Vite)
WEB_PORT=5173

# Orígenes CORS permitidos (separados por coma). El WEB_PORT de este worktree
# se agrega automáticamente, así que normalmente no hace falta tocar esto.
CORS_ORIGINS=http://localhost:5173
