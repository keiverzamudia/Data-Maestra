# =============================================================================
# PERFIL LOCAL POR WORKTREE — NO VERSIONADO
# =============================================================================
# Este es el UNICO archivo que se copia a mano en cada worktree/clon:
#     Copy-Item .env.local.example .env.local
# Todo lo demas vive en git (codigo + *.example, sin secretos).
#
# Worktree A:  API_PORT=3001  WEB_PORT=5173
# Worktree B:  API_PORT=3002  WEB_PORT=5174   CORS_ORIGINS=http://localhost:5174
# =============================================================================

# --- Puertos del worktree (los leen Vite y los scripts api-*.ps1) ---
API_PORT=3001
WEB_PORT=5173
CORS_ORIGINS=http://localhost:5173

# --- Aplicacion / base de datos (SQLite dev) ---
NODE_ENV=development
API_PREFIX=api/v1
LOG_LEVEL=debug
DATABASE_URL="file:../data/dev.db"

# --- Sesion / JWT (vacio = fallback solo-dev) ---
JWT_SECRET=
AUTH_SESSION_TTL_HOURS=8

# --- Modo pruebas: borrado de datos operativos (Maintenance).
# Habilita el botón Administración → Mantenimiento. Nunca en producción.
ALLOW_TEST_RESET=false

# --- Profit SQL Server (READ-ONLY) — completar credenciales reales ---
PROFIT_DB_SERVER=
PROFIT_DB_DATABASE=
PROFIT_DB_USER=
PROFIT_DB_PASSWORD=
PROFIT_ENV=production
PROFIT_WRITE_ENABLED=false

# --- Profit escritura (auth windows = identidad del proceso API) ---
PROFIT_WRITE_AUTH=windows
PROFIT_WRITE_SERVER=
PROFIT_WRITE_DATABASE=

# --- Trazabilidad de origen (codigo funcional en co_us_in). No es credencial. ---
PROFIT_INTEGRATION_USER_CODE=DM
