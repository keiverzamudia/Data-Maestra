# =============================================================================
# PRUEBAS — FUENTE ÚNICA DE CONFIGURACIÓN LOCAL
# Cambiar de entorno = editar API_PORT + FRONT_PORT y reiniciar.
#   Secundario (actual): API_PORT=3002 / FRONT_PORT=5174
# Los secretos Profit viven en apps/api/.env.local (gitignorado, manda).
# NO crear .env.local raíz: duplica y diverge (CORS). NO editar vite.config.js.
# =============================================================================

# Application
NODE_ENV=development
PORT=3002
API_PORT=3002
FRONT_PORT=5174
API_PREFIX=api/v1

# Database (SQLite dev — el schema exige file:. NO compartir el .db entre
# dos APIs vivas. Cada checkout usa su propio archivo.)
DATABASE_URL="file:../data/dev.db"

# CORS (ambos frontends; el secundario es el de este checkout)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Logging
LOG_LEVEL=debug

# Profit Integration (READ-ONLY)
# Valores reales en apps/api/.env.local (tiene prioridad). Aquí solo placebo.
# PROFIT_DB_SERVER=
# PROFIT_DB_DATABASE=
# PROFIT_DB_USER=
# PROFIT_DB_PASSWORD=
# PROFIT_ENV=test
# PROFIT_WRITE_ENABLED=false
